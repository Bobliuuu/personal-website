---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import Scenery from "../components/Scenery.astro";
import Chip from "../components/Chip.astro";
import Button from "../components/Button.astro";
import { profile, links, seasonStats, scouting, featured } from "../data/site";
import { experiences } from "../data/experience";
import { education } from "../data/education";
import { publications, awards } from "../data/achievements";
import { contributions } from "../data/contributions";
import { projects } from "../data/projects";
import { skillCategories } from "../data/skills";

const dates = (d: string | string[]) => (Array.isArray(d) ? d.join(" – ") : d);
const hackathons = projects.filter((p) => p.winner).slice(0, 12);
const rankAwards = awards.slice(0, 6);
const wins = awards.slice(6);
---
<Base>
  <Hero />

  <!-- SEASON STATS -->
  <section class="sec" id="stats" style="padding-block: var(--s-8)">
    <div class="wrap">
      <div class="stats">
        {seasonStats.map((s, i) => (
          <div class="stat reveal" style={`--i:${i}`}>
            <b data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</b>
            <span class="mono">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SCOUTING REPORT -->
  <section class="sec" id="scouting">
    <div class="wrap">
      <SectionHead kicker="01 · Scouting report" title="The player" lede="CS and pure math at Waterloo, varsity ultimate on the weekends. I like systems where the hard part is correctness at scale: pipelines, clusters, and the occasional language model that does arithmetic on purpose." />
      <div class="scout">
        <dl class="card sheet reveal">
          {scouting.map(([k, v]) => (<><dt class="mono muted">{k}</dt><dd>{v}</dd></>))}
        </dl>
        <div class="stack reveal" style="--i:2">
          <h3>Off the field</h3>
          <p class="muted">Varsity ultimate (Open B) for Waterloo, a cappella and dance, gardening, and running far too many student clubs.</p>
          <div class="chips">
            <Chip variant="accent">Ultimate</Chip><Chip>A cappella</Chip><Chip>Hip hop</Chip><Chip>Table tennis</Chip><Chip>Gardening</Chip><Chip>Intramural champion</Chip>
          </div>
          <h3 style="margin-top: var(--s-6)">Strengths</h3>
          <div class="skills">
            {skillCategories.map((c) => (
              <details class="skill" open={c.id === "infrastructure"}>
                <summary class="mono">{c.name}</summary>
                <div class="chips">{c.skills.map((s) => <Chip>{s}</Chip>)}</div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHT REEL -->
  <section class="sec" id="reel">
    <div class="wrap">
      <SectionHead kicker="02 · Highlight reel" title="Best plays" lede="Compiling real programs into the weights of a stock language model, plus the systems work that came before." />
      <div class="reel">
        {featured.map((f, i) => (
          <a class="card reel-card reveal" style={`--i:${i % 4}`} href={f.href} target="_blank" rel="noopener">
            <span class="mono tag">{f.tag}</span>
            <h3>{f.title}</h3>
            <p class="muted">{f.blurb}</p>
            <span class="mono more">{f.stat ?? "View"} <i>↗</i></span>
          </a>
        ))}
      </div>
      <h3 class="sub reveal">Tournament wins <small class="mono muted">hackathons</small></h3>
      <div class="hacks">
        {hackathons.map((p, i) => (
          <a class="hack reveal" style={`--i:${i % 6}`} href={p.link} target="_blank" rel="noopener">
            <img src={p.image} alt="" loading="lazy" decoding="async" width="400" height="240" />
            <span class="hack-meta"><b>{p.title}</b><span class="mono muted">{p.year}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CAREER LOG -->
  <section class="sec scenic" id="log">
    <Scenery kind="forest" flip />
    <div class="wrap">
      <SectionHead kicker="03 · Season log" title="Career" lede="Every club I've played for. Tap a row for the box score." />
      <div class="log-list">
        {experiences.map((e, i) => (
          <details class="row reveal" style={`--i:${i % 3}`} open={i === 0}>
            <summary>
              <img src={e.logo} alt="" width="44" height="44" loading="lazy" decoding="async" />
              <span class="row-main"><b>{e.title}</b><span class="muted">{e.company}</span></span>
              <span class="mono muted row-date">{dates(e.date)}</span>
              <i class="chev" aria-hidden="true">+</i>
            </summary>
            <div class="row-body">
              <ul role="list">{e.points.map((p) => <li>{p}</li>)}</ul>
              {e.tags && <div class="chips">{e.tags.map((t) => <Chip>{t}</Chip>)}</div>}
              <p class="mono muted">{e.location}{e.description ? ` · ${e.description}` : ""}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ACADEMICS -->
  <section class="sec scenic" id="academics">
    <Scenery kind="mountain" flip />
    <div class="wrap">
      <SectionHead kicker="04 · Academics & honours" title="Classroom" />
      <div class="edu">
        {education.filter((e) => e.activities || e.scholarships).map((e) => (
          <article class="card reveal">
            <img src={e.logo} alt="" width="120" height="48" loading="lazy" style="height:48px;width:auto;filter:var(--logo-filter, none)" class="edu-logo" />
            <h3>{e.institution}</h3>
            <p class="mono muted">{e.degree} · {e.dates}</p>
            {e.grade && <p class="grade"><b>{e.grade}</b><span class="mono muted">{e.institution.startsWith("Univ") ? "GPA" : "Average"}</span></p>}
            {e.scholarships && <ul role="list" class="muted">{e.scholarships.map((s) => <li>{s}</li>)}</ul>}
            {e.activities && <details><summary class="mono">Clubs & teams ({e.activities.length})</summary><div class="chips">{e.activities.map((a) => <Chip>{a}</Chip>)}</div></details>}
          </article>
        ))}
      </div>

      <h3 class="sub reveal">Rankings & medals</h3>
      <div class="medals">
        {rankAwards.map((a, i) => (
          <div class="medal reveal" style={`--i:${i}`}><span class="mono muted">{a.date}</span><b>{a.title}</b><span>{a.issuer}</span></div>
        ))}
      </div>
      <h3 class="sub reveal">Trophy case</h3>
      <div class="medals">
        {wins.map((a, i) => (
          <div class="medal reveal" style={`--i:${i % 6}`}><span class="mono muted">{a.date}</span><b>{a.title}</b><span>{a.issuer}</span>{a.description && <p class="muted">{a.description}</p>}</div>
        ))}
      </div>

      <h3 class="sub reveal">Playbook <small class="mono muted">publications</small></h3>
      <div class="playbook">
        {publications.map((p, i) => (
          <a class="spine reveal" style={`--i:${i}`} href={p.url} target="_blank" rel="noopener">
            <span class="mono pub">{p.publisher}</span>
            <b>{p.title}</b>
            <span class="mono muted">{p.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="sec" id="lead">
    <div class="wrap">
      <SectionHead kicker="05 · Captaincy" title="Leadership & community" />
      <div class="lead">
        {contributions.map((c, i) => (
          <article class="lead-item reveal" style={`--i:${i % 3}`}>
            <p class="mono muted">{c.date}</p>
            <h3>{c.title}</h3>
            <p class="org">{c.organization}</p>
            <ul role="list" class="muted">{c.points.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="sec scenic contact" id="recruit">
    <Scenery kind="water" />
    <div class="wrap">
      <SectionHead kicker="06 · Recruiting" title="Let's talk" />
      <p class="big reveal">Hiring for a team that ships hard problems? Say hi. Open to internships and full-time starting 2027.</p>
      <div class="hero-cta reveal" style="display:flex;gap:var(--s-3);flex-wrap:wrap;margin-top:var(--s-6)">
        <Button href={`mailto:${profile.email}`}>Email me</Button>
        <Button href={profile.resume} variant="ghost">Resume (PDF)</Button>
      </div>
      <ul role="list" class="socials mono reveal">
        {links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.name} ↗</a></li>)}
      </ul>
      <p class="mono muted foot">© {new Date().getFullYear()} Jerry Zhu · <a href="/design">Design system</a></p>
    </div>
  </section>
</Base>

<style>
  .scenic { overflow: clip; }
  .scenic > .wrap { position: relative; z-index: 1; }
  .scout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--s-7); align-items: start; }
  .sheet { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3) var(--s-5); margin: 0; }
  .sheet dd { margin: 0; font-weight: 600; }
  .skills { display: grid; gap: var(--s-3); }
  .skill summary, .row summary, details > summary { cursor: pointer; list-style: none; }
  .skill summary { padding: var(--s-3) 0; border-bottom: 1px solid var(--line); }
  .skill .chips { padding-block: var(--s-3); }
  .sub { margin-block: var(--s-8) var(--s-5); }
  .sub small { font-size: var(--step--1); margin-left: var(--s-3); }

  .reel { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: var(--s-4); }
  .reel-card { display: flex; flex-direction: column; gap: var(--s-3); min-height: 15rem; }
  .reel-card .tag { color: var(--accent); }
  .reel-card .more { margin-top: auto; color: var(--fg); }
  .reel-card:hover .more { color: var(--accent); }
  .hacks { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: var(--s-4); }
  .hack { text-decoration: none; display: grid; gap: var(--s-2); }
  .hack img { aspect-ratio: 5/3; width: 100%; object-fit: cover; border-radius: var(--r-md); border: 1px solid var(--line); transition: transform var(--dur-3) var(--ease-out); }
  .hack:hover img { transform: scale(1.03) rotate(-0.6deg); }
  .hack-meta { display: flex; justify-content: space-between; align-items: baseline; }

  .log-list { border-top: 2px solid var(--fg); }
  .row { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 85%, transparent); }
  .row summary { display: grid; grid-template-columns: 44px 1fr auto 1.5rem; gap: var(--s-4); align-items: center; padding: var(--s-4) 0; }
  .row summary::-webkit-details-marker { display: none; }
  .row img { width: 44px; height: 44px; object-fit: contain; background: #fff; border-radius: var(--r-sm); padding: 4px; }
  .row-main { display: grid; }
  .row-main b { font: 800 var(--step-2)/1 var(--font-display); text-transform: uppercase; }
  .chev { font: 300 1.8rem/1 var(--font-mono); font-style: normal; color: var(--accent); transition: transform var(--dur-2); }
  .row[open] .chev { transform: rotate(45deg); }
  .row:hover { background: var(--bg-raised); }
  .row-body { padding: 0 0 var(--s-5) calc(44px + var(--s-4)); display: grid; gap: var(--s-3); max-width: 70ch; }
  .row-body ul { display: grid; gap: var(--s-2); }
  .row-body li::marker { content: "▸ "; color: var(--accent); }
  .row-body ul { padding-left: 1.1rem; list-style: inside; }
  @media (max-width: 640px) { .row summary { grid-template-columns: 44px 1fr 1.5rem; } .row-date { display: none; } .row-body { padding-left: 0; } }

  .edu { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: var(--s-4); }
  .edu .card { display: grid; gap: var(--s-3); align-content: start; }
  .edu-logo { background: #fff; padding: 6px 10px; border-radius: var(--r-sm); }
  .grade b { font: 800 var(--step-4)/1 var(--font-display); color: var(--accent); margin-right: var(--s-2); }
  .medals { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: var(--s-3); }
  .medal { display: grid; gap: var(--s-1); padding: var(--s-4); border-left: 3px solid var(--accent-2); background: color-mix(in srgb, var(--bg-raised) 80%, transparent); border-radius: 0 var(--r-md) var(--r-md) 0; align-content: start; }
  .medal b { font: 800 var(--step-1)/1.1 var(--font-display); text-transform: uppercase; }
  .medal p { font-size: var(--step--1); }

  .playbook { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--s-3); }
  .spine { text-decoration: none; display: grid; gap: var(--s-3); padding: var(--s-5) var(--s-5) var(--s-5) var(--s-6); background: var(--bg-raised); border: 1px solid var(--line); border-radius: 4px var(--r-md) var(--r-md) 4px; position: relative; box-shadow: var(--shadow-1); transition: transform var(--dur-3) var(--ease-out); }
  .spine::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 14px; background: var(--accent); border-radius: 4px 0 0 4px; }
  .spine:hover { transform: translateY(-6px) rotate(-1deg); }
  .pub { color: var(--accent); }

  .lead { display: grid; grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr)); gap: var(--s-6) var(--s-5); }
  .lead-item { border-top: 1px solid var(--line); padding-top: var(--s-4); display: grid; gap: var(--s-2); align-content: start; }
  .lead-item .org { color: var(--accent); font-weight: 600; }
  .lead-item ul { padding-left: 1.1rem; }

  .contact { padding-bottom: calc(var(--s-9) + 8rem); }
  .big { font: 800 var(--step-3)/1 var(--font-display); text-transform: uppercase; max-width: 22ch; }
  .socials { display: flex; flex-wrap: wrap; gap: var(--s-5); margin-top: var(--s-7); padding: 0; }
  .socials a { text-decoration: none; } .socials a:hover { color: var(--accent); }
  .foot { margin-top: var(--s-8); }
  @media (max-width: 860px) { .scout { grid-template-columns: 1fr; } }
</style>
