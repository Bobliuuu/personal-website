---
import "@fontsource-variable/inter";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/800.css";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import Nav from "../components/Nav.astro";
interface Props { title?: string; description?: string }
const { title = "Jerry Zhu | Software Engineer & Varsity Ultimate Player", description = "Jerry Zhu: Waterloo CS + Math '27, varsity ultimate player, software engineer on data, infra, and ML systems." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0d0c" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({"@context":"https://schema.org","@type":"Person",name:"Jerry Zhu",url:"https://jerryzhu.org",alumniOf:"University of Waterloo",jobTitle:"Software Engineer",sameAs:["https://github.com/bobliuuu","https://www.linkedin.com/in/jerryzhu2/"]})} />
  </head>
  <body>
    <canvas id="boids" aria-hidden="true"></canvas>
    <Nav />
    <main><slot /></main>
    <script>import "../scripts/main";</script>
  </body>
</html>
<style is:global>
  #boids { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: .3; }
  main, .nav { position: relative; z-index: 1; }
  .nav { position: fixed; }
</style>
