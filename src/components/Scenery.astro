---
// Sport-themed scenery (mountain / forest / water), pure SVG, no images.
// Kept from the old site's mountain + forest + underwater idea; recoloured via tokens.
interface Props { kind: "mountain" | "forest" | "water"; flip?: boolean }
const { kind, flip = false } = Astro.props;
---
<div class:list={["scenery", `scenery--${kind}`, { flip }]} aria-hidden="true">
  {kind === "mountain" && (
    <svg viewBox="0 0 1440 260" preserveAspectRatio="none">
      <path class="far" d="M0 260V150l120-60 90 50 140-110 130 120 110-70 150 90 120-100 160 130 130-80 140 70 150-90V260Z"/>
      <path class="near" d="M0 260V200l160-70 120 60 180-110 170 130 150-80 200 100 140-60 220 80V260Z"/>
    </svg>
  )}
  {kind === "forest" && (
    <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path class="far" d={"M0 200V120" + Array.from({length: 48}, (_, i) => `l15 -${30 + (i*37)%40} l15 ${30 + (i*37)%40 - 0}`).join("") + "V200Z"}/>
      <path class="near" d={"M0 200V150" + Array.from({length: 36}, (_, i) => `l20 -${40 + (i*53)%45} l20 ${40 + (i*53)%45}`).join("") + "V200Z"}/>
    </svg>
  )}
  {kind === "water" && (
    <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path class="far wave" d="M0 80c120-40 240-40 360 0s240 40 360 0 240-40 360 0 240 40 360 0V200H0Z"/>
      <path class="near wave2" d="M0 120c120-30 240-30 360 0s240 30 360 0 240-30 360 0 240 30 360 0V200H0Z"/>
    </svg>
  )}
</div>
<style>
  .scenery { position: absolute; inset-inline: 0; height: clamp(120px, 18vw, 260px); pointer-events: none; z-index: 0; bottom: 0; }
  .scenery.flip { bottom: auto; top: 0; transform: scaleY(-1); }
  svg { width: 100%; height: 100%; }
  .far { fill: var(--bg-raised); opacity: 0.55; }
  .near { fill: var(--bg-raised); }
  .wave { animation: drift 14s ease-in-out infinite alternate; }
  .wave2 { animation: drift 9s ease-in-out infinite alternate-reverse; }
  @keyframes drift { to { transform: translateX(-4%); } }
  @media (prefers-reduced-motion: reduce) { .wave, .wave2 { animation: none; } }
</style>
